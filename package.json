{
  "name": "digitrans-logistics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "node --env-file=.env --env-file-if-exists=.env.production server/index.js",
    "seed": "node --env-file=.env scripts/seed-supabase.js",
    "db:seed": "node --env-file=.env scripts/seed-supabase.js",
    "db:migrate": "node --env-file=.env scripts/apply-supabase-migrations.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@electric-sql/pglite": "^0.3.16",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8"
  }
}
