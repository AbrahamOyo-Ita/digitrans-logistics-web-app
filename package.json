{
  "name": "digitrans-logistics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:vercel": "vercel dev",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir ../dist-ssr && node scripts/prerender.mjs",
    "build:images": "node scripts/optimize-images.mjs",
    "indexnow": "node scripts/ping-indexnow.mjs",
    "seed": "node --env-file=.env scripts/seed-supabase.js",
    "db:seed": "node --env-file=.env scripts/seed-supabase.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/apply-supabase-migrations.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@electric-sql/pglite": "^0.3.16",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vercel": "^66.5.0",
    "vite": "^8.3.8"
  }
}
