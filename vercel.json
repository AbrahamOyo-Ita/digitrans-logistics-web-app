{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/transactional-emails.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/scheduled-deliveries", "schedule": "0 0 * * *" },
    { "path": "/api/cron/transactional-emails", "schedule": "0 0 * * *" }
  ],
  "routes": [
    { "src": "/api/cron/scheduled-deliveries", "dest": "/api/cron/scheduled-deliveries.js" },
    { "src": "/api/cron/transactional-emails", "dest": "/api/cron/transactional-emails.js" },
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
