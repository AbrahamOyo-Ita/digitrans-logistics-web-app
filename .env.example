# Example only. Store real secrets in the Node host's secret manager; never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1

# Public web origin. Use HTTPS and the actual production domain.
APP_URL=https://www.digitransdelivery.com
# Comma-separated browser origins allowed to call this API.
CLIENT_ORIGINS=https://www.digitransdelivery.com
# Use SameSite=None and Secure when the web app and API are cross-site (for example, Vercel + a separate Node host).
SESSION_COOKIE_SAME_SITE=lax

# Supabase server credentials. Never expose the service-role key to the browser.
SUPABASE_URL=https://ogwrmyvssfkpmoqmnoxe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key
# Use the direct or session-pooler PostgreSQL connection string; TLS certificate verification is enforced in production.
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.ogwrmyvssfkpmoqmnoxe.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_POOL_MAX=10
# Optional only for local development without TLS; production always enforces verified TLS.
# SUPABASE_DB_SSL=disable

# Production Auth verification and recovery email delivery. Verify the sender domain in Resend.
RESEND_API_KEY=re_replace-with-resend-key
RESEND_FROM_EMAIL=DigiTrans <no-reply@digitransdelivery.com>
CONTACT_RECIPIENT_EMAIL=

# Optional until online payments are approved and configured.
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=https://www.digitransdelivery.com/payment/return

# Guarded migration/seed runner target identity. These are not runtime connection credentials.
SUPABASE_DB_TARGET=production
SUPABASE_PRODUCTION_DB_HOST=db.ogwrmyvssfkpmoqmnoxe.supabase.co
SUPABASE_PRODUCTION_DB_USER=postgres
# Applying production migrations/seeds additionally requires --approve-production and a temporary
# SUPABASE_PRODUCTION_MIGRATION_APPROVAL=I_REVIEWED_BACKUP_AND_CUTOVER_PLAN confirmation.

# Optional one-time bootstrap values for `npm run db:seed -- --apply --approve-production`.
# Do not leave the password in the environment after the guarded seed operation.
BOOTSTRAP_ADMIN_NAME=DigiTrans Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=+2348000000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

# Vercel frontend build setting (not an API runtime secret):
# Set only after the Node API is deployed and DNS for this origin is configured.
# VITE_API_BASE_URL=https://api.digitransdelivery.com
