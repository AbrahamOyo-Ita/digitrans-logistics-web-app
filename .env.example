# Example only. Store real secrets in Vercel environment variables; never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1

# Public web origin and exact browser origins allowed to call the API.
APP_URL=https://www.digitransdelivery.com
# Include both production hostnames; the browser may arrive from either one.
CLIENT_ORIGINS=https://digitransdelivery.com,https://www.digitransdelivery.com
SESSION_COOKIE_SAME_SITE=lax

# Supabase server credentials. Never expose the service-role key to the browser.
SUPABASE_URL=https://ogwrmyvssfkpmoqmnoxe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.ogwrmyvssfkpmoqmnoxe.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_POOL_MAX=10
# Optional when the server cannot use the bundled Supabase CA certificate.
# SUPABASE_DB_CA=<PEM-encoded Supabase CA certificate>
# SUPABASE_DB_SSL=disable

# Transactional email. Verify the sending domain in Resend before production delivery.
RESEND_API_KEY=re_replace-with-resend-key
RESEND_FROM_EMAIL=DigiTrans <no-reply@digitransdelivery.com>
CONTACT_RECIPIENT_EMAIL=
# Protect Vercel cron endpoints; set the same long random value in the Vercel environment.
CRON_SECRET=replace-with-a-long-random-cron-secret
# Optional hard gate for deployments that must have an active super administrator before serving.
# REQUIRE_ACTIVE_SUPER_ADMIN=false

# Payments.
# Hosted Paystack checkout uses the server secret only; never expose it to Vite/browser code.
# Use the test key first (sk_test_...), then replace it with the live key (sk_live_...) at launch.
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=https://www.digitransdelivery.com/payment/return

# Guarded production migration/seed runner settings.
SUPABASE_DB_TARGET=production
SUPABASE_PRODUCTION_DB_HOST=db.ogwrmyvssfkpmoqmnoxe.supabase.co
SUPABASE_PRODUCTION_DB_USER=postgres
# Applying production migrations/seeds requires --approve-production and:
# SUPABASE_PRODUCTION_MIGRATION_APPROVAL=I_REVIEWED_BACKUP_AND_CUTOVER_PLAN

# Optional one-time bootstrap values. Remove the password after seeding.
BOOTSTRAP_ADMIN_NAME=DigiTrans Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=+2348000000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

# Vercel frontend build setting (not an API runtime secret).
# Leave unset in production: the browser calls the same-origin Vercel /api functions.
# VITE_API_BASE_URL=http://localhost:3000
