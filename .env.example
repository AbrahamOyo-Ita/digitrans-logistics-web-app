# Copy values into your deployment platform's secret/configuration store.
# Never commit .env or real secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1
DISABLE_DEMO_SEED=true

# This SQLite backend needs a single Node host with persistent writable storage.
# Vercel does not provide persistent local disk for this database or uploads.
DATABASE_PATH=/var/lib/digitrans/digitrans.db
UPLOADS_DIR=/var/lib/digitrans/uploads

# Public web app origin. Use HTTPS and your real domain.
APP_URL=https://your-production-domain.example
# Comma-separated browser origins allowed to call this API (include the Vercel custom domain if different).
CLIENT_ORIGINS=https://your-production-domain.example
SESSION_COOKIE_SAME_SITE=lax

# Required on the first production start if no active super admin exists.
# Set a unique 12+ character password with uppercase, lowercase, number and one of !@#$%^&*.
BOOTSTRAP_ADMIN_NAME=DigiTrans Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=+2348000000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

# Optional until live payments are approved and configured.
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=https://your-production-domain.example/payment/return

# Optional Resend transactional email. The sender domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DigiTrans <no-reply@your-production-domain.example>
CONTACT_RECIPIENT_EMAIL=

# Vercel frontend build setting (not an API runtime secret):
# VITE_API_BASE_URL=https://api.your-production-domain.example
